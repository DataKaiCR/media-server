[Unit]
Description=Apply conservative default torrent seeding classifications
Documentation=file://%h/projects/media-server/docs/seeding-evidence.md
Wants=network-online.target media-download-stack.service
After=network-online.target media-download-stack.service

[Service]
Type=oneshot
UMask=0077
WorkingDirectory=%h/projects/media-server
ExecStart=/usr/bin/python3 %h/projects/media-server/scripts/seeding-classify.py --config %h/appdata/seeding-evidence/config.toml --public-default-tier standard --private-default-tier contributor --apply
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/appdata/seeding-evidence/reports
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=default.target
