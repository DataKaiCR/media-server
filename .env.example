# Copy to .env and keep that file private. Compose reads this file implicitly.

# Host identity
PUID=1000
PGID=1000
TZ=UTC

# Storage
# DATA must contain both media/ and torrents/ on one filesystem for hardlinks.
DATA=/srv/media-data
APPDATA=/srv/media-appdata
TRANSCODE=/srv/media-transcodes

# Whisper model cache. Keep model weights on fast local storage.
WHISPER_CACHE=/srv/media-models/whisper
WHISPER_MODEL=medium
# Release GPU memory after this many idle seconds; 0 keeps the model loaded.
WHISPER_IDLE_TIMEOUT=600

# Local exposure
LAN_SUBNETS=192.168.1.0/24
QBITTORRENT_WEBUI_PORT=8090
TORRENT_PORT=6881

# Optional Traefik discovery for the language-specific request portal.
TRAEFIK_NETWORK=media-server_media
LATINO_REQUEST_HOST=latino.example.internal

# VPN download profile
VPN_PROVIDER=
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
VPN_COUNTRIES=
