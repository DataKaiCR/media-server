# DataKai media stack — gruff
# Copy to .env in the same directory as docker-compose.yml.
# .env must be gitignored: it holds VPN credentials.

# ---------------------------------------------------------------- paths ----
# Single data root. torrents/ and media/ live UNDER this on one filesystem so
# the *arr apps can hardlink on import instead of copying. Do not split these
# onto separate mounts — that silently reverts to full-copy imports.
DATA=/var/mnt/data

# Config + databases. These are SQLite and want NVMe, never the spinning disk.
# Move to the second NVMe once nvme1n1 is reformatted.
APPDATA=/var/home/datakai/appdata

# Jellyfin transcode scratch. Keep on NVMe — transcoding to the HDD will make
# the library stutter while it writes.
TRANSCODE=/var/home/datakai/appdata/jellyfin-transcodes

# ------------------------------------------------------------------ VPN ----
# Gluetun provider name. Run this to see valid values:
#   podman run --rm qmcgaw/gluetun:v3.40.0 format-servers -h
# The OpenVPN bundles on the 2TB archive (AES-256-UDP.zip, BF-128-UDP.zip)
# should identify the provider.
VPN_PROVIDER=

# wireguard is preferred: faster, and a single keypair instead of cert files.
# Use openvpn only if the provider does not offer WireGuard.
VPN_TYPE=wireguard

# WireGuard credentials from the provider's config generator.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Comma-separated exit countries, e.g. "Netherlands,Switzerland"
VPN_COUNTRIES=
